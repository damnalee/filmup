# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_private_backend_key

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=your_supported_groq_model_id

# Application
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Karachi

# Background scraper schedule
SCRAPER_ENABLED=true
SCRAPER_SCHEDULE_MINUTE=5
SCRAPER_INTERVAL_HOURS=1

# HTTP collection settings
SCRAPER_REQUEST_TIMEOUT=20
SCRAPER_MAX_CONCURRENCY=6

# Resend transactional email (verify your domain for production sending)
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM_EMAIL=onboarding@resend.dev
MAIL_FROM_NAME=FilmUp Notifications

# Scraper monitoring storage: auto (Supabase, then SQLite fallback), supabase, or sqlite
SCRAPER_MONITOR_STORAGE=auto
# Optional local SQLite path (used for local development/offline fallback)
# SCRAPER_MONITOR_DB_PATH=./scrape_output/monitoring.sqlite3
