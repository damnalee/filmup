# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_private_backend_key

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=your_supported_groq_model_id

# Application
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Karachi

# Background scraper schedule
SCRAPER_ENABLED=true
SCRAPER_SCHEDULE_MINUTE=5
SCRAPER_INTERVAL_HOURS=1

# HTTP collection settings
SCRAPER_REQUEST_TIMEOUT=20
SCRAPER_MAX_CONCURRENCY=6

# Email notifications (required for advance-booking confirmation and alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_sender@example.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SENDER_NAME=FilmUp Notifications

# Optional local path for the scraper monitoring SQLite database
# SCRAPER_MONITOR_DB_PATH=./scrape_output/monitoring.sqlite3
